{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .. --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test -- --runInBand && npm run build && npm run openapi:check",
    "prebuild": "npm run lint",
    "pretest": "npm run lint && npm run test:lint-policy",
    "test:lint-policy": "node --test tests/tooling/no-casts.test.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && node dist/app.js",
    "dev": "npm run build && nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/app.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "devstart": "DEBUG=personal-express-ts-setup* npm run dev",
    "generate:resource": "node scripts/generate-resource.js",
    "openapi:generate": "ts-node src/openapi/generate.ts",
    "openapi:check": "ts-node src/openapi/generate.ts --check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.7.2",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv": "^17.2.3",
    "eslint": "^10.13.0",
    "express": "^5.1.0",
    "install": "^0.13.0",
    "jest": "^30.2.0",
    "node-mocks-http": "^1.18.1",
    "nodemon": "^3.1.10",
    "npm": "^11.6.2",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@node-rs/argon2": "^2.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express-async-handler": "^1.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "mysql2": "^3.15.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.5"
  }
}
